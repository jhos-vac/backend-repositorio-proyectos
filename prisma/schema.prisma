generator client {
  provider = "prisma-client"
  output   = "../src/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String
  name     String
  image    String?

  // Relaciones
  roleId   String
  role     Role   @relation(fields: [roleId], references: [id])
  careerId String
  career   Career @relation(fields: [careerId], references: [id])

  // Recuperación de contraseña (Ya los tenías)
  resetToken       String?
  resetTokenExpiry DateTime?

  // --- NUEVOS CAMPOS PARA VERIFICACIÓN DE CORREO ---
  isVerified      Boolean @default(false) // Por defecto es falso hasta que den clic al correo
  activationToken String? // El código único que se envía por email
  // --------------------------------------------------

  // --- NUEVO CAMPO PARA CAMBIO DE CONTRASEÑA OBLIGATORIO ---
  needsPasswordChange Boolean @default(false)

  // Se incrementa para revocar todos los JWT emitidos (cambio de clave, logout)
  tokenVersion Int @default(0)

  // Nivel del estudiante (1 a 4). Junto con la carrera define su docente asignado.
  level Int?
  // ---------------------------------------------------------

  projects            UserProject[]
  teachingAssignments TeacherAssignment[]
  reviewedProjects    Project[]           @relation("ProjectReviewer")
  uploadedDocuments   ProjectDocument[]   @relation("DocumentUploader")
  createdLinks        ProjectLink[]       @relation("LinkCreator")
  createdProjects     Project[]           @relation("UserCreatedProjects")

  createdSkills Skills[] @relation("UserCreatedSkills")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  users       User[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  roles       RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model Career {
  id   String @id @default(uuid())
  name String

  users              User[]
  projects           Project[]
  teacherAssignments TeacherAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id              String   @id @default(uuid())
  name            String
  description     String
  status          String   @default("en progreso") // 'en progreso' | 'completado'
  problems        String?
  summary         String?
  objectives      String[]
  cycle           String?
  academic_period String?
  deliverables    String[] @default([])

  startDate DateTime?
  endDate   DateTime?

  createdBy String?
  user      User?   @relation(fields: [createdBy], references: [id], name: "UserCreatedProjects")
  careerId  String
  career    Career  @relation(fields: [careerId], references: [id])

  // Nivel (1-4) del autor al crear el proyecto: junto con la carrera define quién lo revisa
  level Int?

  // Revision del docente: pending | approved | rejected (los proyectos ya existentes quedan approved)
  reviewStatus String    @default("approved")
  reviewNote   String?
  reviewedById String?
  reviewedBy   User?     @relation("ProjectReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  // Continuidad ("ramas"): parentId = proyecto del que se continua; rootId = origen de la cadena
  parentId     String?
  parent       Project?  @relation("ProjectBranches", fields: [parentId], references: [id], onDelete: SetNull)
  branches     Project[] @relation("ProjectBranches")
  rootId       String?
  branchNumber Int       @default(1)

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  userProjects  UserProject[]
  projectSkills projectSkills[]
  documents     ProjectDocument[]
  links         ProjectLink[]
}

model UserProject {
  id        String @id @default(uuid())
  userId    String
  projectId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

model Skills {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  details     Json?

  createdById String?
  createdBy   User?   @relation("UserCreatedSkills", fields: [createdById], references: [id])

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  projectSkills projectSkills[]
}

model projectSkills {
  id        String @id @default(uuid())
  projectId String
  skillId   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill   Skills  @relation(fields: [skillId], references: [id])

  @@unique([projectId, skillId])
}

/// Período académico configurado por el ADMIN: solo mes y año de inicio y de fin (ej. Septiembre-2026 → Enero-2027).
model Period {
  id         String   @id @default(uuid())
  name       String   @unique
  startMonth Int?
  startYear  Int?
  endMonth   Int?
  endYear    Int?
  createdAt DateTime @default(now())
}

/// Docente encargado de una carrera + nivel: acepta y revisa los proyectos de esos estudiantes.
model TeacherAssignment {
  id        String   @id @default(uuid())
  careerId  String
  career    Career   @relation(fields: [careerId], references: [id], onDelete: Cascade)
  level     Int
  teacherId String
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([careerId, level])
}

/// PDF de un proyecto (informe, presentación…). El archivo vive en el disco del servidor, fuera de /uploads.
model ProjectDocument {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind         String   @default("otro") // informe | presentacion | otro
  originalName String
  storedName   String   @unique // nombre aleatorio en disco
  size         Int
  sha256       String
  uploadedById String?
  uploadedBy   User?    @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@unique([projectId, sha256])
  @@index([projectId])
}

/// Enlace externo del proyecto: repositorio (GitHub…), demo, video. `isFinal` marca el registro del producto final.
model ProjectLink {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        String   @default("otro") // repositorio | demo | video | otro
  label       String?
  url         String
  ref         String? // tag o commit de la versión final
  isFinal     Boolean  @default(false)
  createdById String?
  createdBy   User?    @relation("LinkCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@unique([projectId, url])
  @@index([projectId])
}
